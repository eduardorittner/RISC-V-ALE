--- /dev/null
+++ b/AleTiming.hpp
@@ -0,0 +1,113 @@
+// Startup timing marks for RISC-V ALE.
+//
+// The report `local/36ms.md` needs to know where the milliseconds between the
+// run message and the end of a small program go. The startup harness
+// (`scripts/perf-core/startup/`) can only see the parts that JavaScript can
+// see: the fetch, the module instantiation and the two hooks. Everything
+// between the `preRun` hook and the first guest instruction is one number, and
+// that number is the largest part. These marks divide it.
+//
+// The whole file is inert unless `ALE_TIME_STARTUP` is defined, so a build
+// without that macro gives the module that the branch ships, byte for byte.
+//
+// Usage:
+//   ALE_MARK("name");   record the name and the time
+//   ALE_TIME_DUMP();    write one `ALE_TIME <name> <ms>` line for each mark
+//
+// The clock is `emscripten_get_now()`, which Emscripten implements as
+// `performance.now()`. The module and the worker therefore share one clock and
+// one time origin, so a mark and a timestamp of the worker are directly
+// comparable.
+
+#ifndef ALE_TIMING_HPP
+#define ALE_TIMING_HPP
+
+#ifdef ALE_TIME_STARTUP
+
+#include <cstdio>
+
+#ifdef __EMSCRIPTEN__
+#include <emscripten.h>
+#endif
+
+namespace AleTime
+{
+  struct Mark
+  {
+    const char* name;
+    double ms;
+  };
+
+  /// The marks. A function-local static needs no C++17 inline variable and no
+  /// definition in a `.cpp` file, so the whole instrumentation is one header.
+  inline Mark* marks()
+  {
+    static Mark storage[256];
+    return storage;
+  }
+
+  inline unsigned& count()
+  {
+    static unsigned n = 0;
+    return n;
+  }
+
+  inline double now()
+  {
+#ifdef __EMSCRIPTEN__
+    return emscripten_get_now();
+#else
+    return 0.0;
+#endif
+  }
+
+  /// Record one mark. `name` must be a string literal: nothing copies it.
+  inline void mark(const char* name)
+  {
+    unsigned& n = count();
+    if (n >= 256)
+      return;
+    marks()[n].name = name;
+    marks()[n].ms = now();
+    n++;
+  }
+
+  /// Write the marks. The lines go to the standard error, which the worker
+  /// collects with `Module.printErr`. The dump runs after the program, so its
+  /// own cost is not inside any measured part.
+  inline void dump()
+  {
+    unsigned n = count();
+    for (unsigned i = 0; i < n; ++i)
+      fprintf(stderr, "ALE_TIME %s %.4f\n", marks()[i].name, marks()[i].ms);
+    fflush(stderr);
+  }
+}
+
+#define ALE_MARK(n) ::AleTime::mark(n)
+
+/// A mark in a place that runs many times. Only the first call records. The
+/// application runs thousands of slices, and 256 marks would not hold them.
+#define ALE_MARK_ONCE(n)                        \
+  do                                            \
+    {                                           \
+      static bool aleFirst = true;              \
+      if (aleFirst)                             \
+        {                                       \
+          aleFirst = false;                     \
+          ALE_MARK(n);                          \
+        }                                       \
+    }                                           \
+  while (false)
+
+#define ALE_TIME_DUMP() ::AleTime::dump()
+
+#else
+
+#define ALE_MARK(n) ((void) 0)
+#define ALE_MARK_ONCE(n) ((void) 0)
+#define ALE_TIME_DUMP() ((void) 0)
+
+#endif  // ALE_TIME_STARTUP
+
+#endif  // ALE_TIMING_HPP
