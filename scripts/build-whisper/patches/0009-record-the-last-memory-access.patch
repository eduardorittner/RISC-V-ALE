+/// The last memory access of the hart, which the debugger page marks.
+///
+/// Kind is 0 when the last instruction was not a load or a store, 1 for a
+/// load and 2 for a store. An atomic instruction counts as a store: it reads
+/// and then writes the same bytes, and the write is the record that stays.
+/// The address and the size are 0 when the kind is 0.
+template <typename URV>
+static
+bool
+aleDbgAccess(uint32_t& addr, uint32_t& size, bool& isStore)
+{
+  auto* hart = aleDebugHart<URV>();
+  URV a = 0;
+  unsigned n = 0;
+  if (not hart or not hart->lastLdStAccess(a, n, isStore))
+    return false;
+  addr = uint32_t(a);
+  size = uint32_t(n);
+  return true;
+}
+
+
+template <typename URV>
+static
+int
+aleDbgAccessKind()
+{
+  uint32_t addr = 0, size = 0;
+  bool isStore = false;
+  if (not aleDbgAccess<URV>(addr, size, isStore))
+    return 0;
+  return isStore? 2 : 1;
+}
+
+
+template <typename URV>
+static
+uint32_t
+aleDbgAccessAddr()
+{
+  uint32_t addr = 0, size = 0;
+  bool isStore = false;
+  return aleDbgAccess<URV>(addr, size, isStore)? addr : 0;
+}
+
+
+template <typename URV>
+static
+uint32_t
+aleDbgAccessSize()
+{
+  uint32_t addr = 0, size = 0;
+  bool isStore = false;
+  return aleDbgAccess<URV>(addr, size, isStore)? size : 0;
+}
+
+
