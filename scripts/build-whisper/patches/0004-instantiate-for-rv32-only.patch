 template class WdRiscv::Hart<uint32_t>;
+// RISC-V ALE has no RV64 toolchain and no way to ask for one: the ISA
+// checkboxes of index.html make an RV32 string, and clang builds an RV32 ELF.
+// ALE_NO_RV64 therefore takes the second instantiation of every template out
+// of the module. The primary template and the RV32 instantiation do not
+// change, so no guest program sees a difference.
+#ifndef ALE_NO_RV64
 template class WdRiscv::Hart<uint64_t>;
+#endif  // ALE_NO_RV64
