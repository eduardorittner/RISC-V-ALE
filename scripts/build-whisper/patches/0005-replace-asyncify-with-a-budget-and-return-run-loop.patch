+/// then returns to JavaScript, and a later slice runs the ecall again.
+template <typename URV>
+void
+Hart<URV>::aleSetBlocked()
+{
+  aleBlocked_ = true;
+  pc_ = currPc_;
+  if (instCounter_ > 0)
+    --instCounter_;     // The ecall did not retire.
+  noUserStop = false;   // Stop the loop. userStop stays false.
+}
