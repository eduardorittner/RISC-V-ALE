+/// Run at most `budget` instructions and return. A budget of zero means no
+/// limit. This is what `run` becomes in a build without Asyncify.
+///
+/// The state of a run lives in the hart, so a call continues where the call
+/// before it stopped. The method reports the instructions per second one time
+/// only, when the program is finished, and it adds the time of every slice.
+///
+/// The return value is the return value of the run. `aleYielded()` says
+/// whether the program is still running, and `aleWaiting()` whether it stopped
+/// to wait for input.
 template <typename URV>
 bool
+Hart<URV>::aleRunSlice(FILE* file, uint64_t budget)
+{
+  // The same test as `run`: any option that the fast loop cannot do sends the
+  // run to the loop that can do everything.
+  URV stopAddr = stopAddrValid_? stopAddr_ : ~URV(0); // ~URV(0): No-stop PC.
+  bool hasClint = clintStart_ < clintLimit_;
+  bool complex = (stopAddrValid_ or instFreq_ or enableTriggers_ or enableGdb_
+                  or enableCounters_ or alarmInterval_ or file or enableWideLdSt_
+                  or hasClint or isRvs());
+
+  if (not aleRunActive_)
+    {
+      aleRunActive_ = true;
+      aleCounter0_ = instCounter_;
+      aleElapsed_ = 0;
+    }
+
+  aleYielded_ = false;
+  aleWaiting_ = false;
+  aleBlocked_ = false;
+
+  // The slice limit goes into instCountLim_, which both loops already test.
+  // The hot loop therefore has no test that it did not have before.
+  uint64_t globalLimit = instCountLim_;
+  if (budget and (globalLimit - instCounter_) > budget)
+    instCountLim_ = instCounter_ + budget;
+
+  struct timeval t0;
+  gettimeofday(&t0, nullptr);
+
+  // Setup signal handlers. Restore on destruction.
+  SignalHandlers handlers;
+
+  bool success = true;
+#ifndef DISABLE_EXCEPTIONS
+  try
+#endif
+    {
+      if (complex)
+        success = untilAddress(stopAddr, file);
+      else
+        {
+          // For speed: do not record/clear CSR changes. The choice between
+          // the two loops is the choice that simpleRun makes, so a slice with
+          // no limit runs the same loop as a run without Asyncify does.
+          enableCsrTrace_ = false;
+          if (instCountLim_ == ~uint64_t(0))
+            success = simpleRunNoLimit();
+          else
+            success = simpleRunWithLimit();
+          enableCsrTrace_ = true;
+        }
+    }
+#ifndef DISABLE_EXCEPTIONS
+  catch (const CoreException& ce)
+    {
+      enableCsrTrace_ = true;
+      success = logStop(ce, 0, nullptr);
+    }
+#endif
+
+  struct timeval t1;
+  gettimeofday(&t1, nullptr);
+  aleElapsed_ += (double(t1.tv_sec - t0.tv_sec) +
+                  double(t1.tv_usec - t0.tv_usec)*1e-6);
+
+  uint64_t sliceLimit = instCountLim_;
+  instCountLim_ = globalLimit;
+
+  if (aleBlocked_)
+    {
+      // A syscall has no input. The hart is back at the ecall instruction and
+      // it runs it again in a later slice.
+      aleBlocked_ = false;
+      noUserStop = true;
+      aleYielded_ = true;
+      aleWaiting_ = true;
+      return success;
+    }
+
+  if (userStop)
+    std::cerr << "Stopped -- interrupted\n";
+  else if (instCounter_ >= globalLimit)
+    std::cerr << "Stopped -- Reached instruction limit\n";
+  else if (complex and pc_ == stopAddr)
+    std::cerr << "Stopped -- Reached end address\n";
+  else if (instCounter_ >= sliceLimit)
+    {
+      // The budget of the slice ran out and nothing else stopped the run.
+      aleYielded_ = true;
+      return success;
+    }
+
+  aleRunActive_ = false;
+  reportInstsPerSec(instCounter_ - aleCounter0_, aleElapsed_, userStop);
+  return success;
+}
