+// ─── The slice driver ───────────────────────────────────────────────────────
+//
+// Asyncify is gone, so nothing in C++ can wait: a wait must be a return to
+// JavaScript. `main` therefore builds the session and returns, and the worker
+// calls `ale_run_slice` from a setTimeout chain. Each call runs at most the
+// number of instructions that the worker asks for.
+//
+// The state that `session` and `sessionRun` kept on their stacks lives here,
+// because it must survive a return to JavaScript.
+
+/// What a slice reports to the worker.
+enum AleStatus
+  {
+    ALE_DONE = 0,   // The program is finished. Do not call again.
+    ALE_RAN  = 1,   // Instructions ran. Call again as soon as possible.
+    ALE_WAIT = 2    // Waiting for the host: for input, or for a shell command.
+  };
+
+template <typename URV>
+struct AleSession
+{
+  std::unique_ptr<System<URV>> system;
+  std::unique_ptr<Interactive<URV>> shell;   // Null unless --interactive
+  const Args* args = nullptr;
+  FILE* traceFile = nullptr;
+  FILE* commandLog = nullptr;
+  FILE* consoleOut = stdout;
+  bool running = false;   // A shell run command is in progress.
+  bool done = false;
+  bool ok = true;
+};
+
+template <typename URV>
+static
+AleSession<URV>&
+aleSession()
+{
+  static AleSession<URV> session;
+  return session;
+}
+
+/// The slice function of the register width that main chose.
+static int (*aleSliceFn)(uint64_t) = nullptr;
+
+
+/// The tail of session: report the instruction frequency and close the files.
+template <typename URV>
+static
+void
+aleFinish()
+{
+  auto& s = aleSession<URV>();
+  if (s.done)
+    return;
+  s.done = true;
+
+  auto& hart0 = *s.system->ithHart(0);
+  if (s.args and not s.args->instFreqFile.empty())
+    s.ok = reportInstructionFrequency(hart0, s.args->instFreqFile) and s.ok;
+
+  closeUserFiles(s.traceFile, s.commandLog, s.consoleOut);
+}
+
+
+/// The setup part of sessionRun. It applies the command line to each hart and
+/// it chooses between the batch run and the interactive shell. It does not run
+/// any instruction: `ale_run_slice` does that.
+template <typename URV>
+static
+bool
+aleStart(System<URV>& system, const Args& args, FILE* traceFile, FILE* cmdLog)
+{
+  auto& s = aleSession<URV>();
+
+  for (unsigned i = 0; i < system.hartCount(); ++i)
+    if (not applyCmdLineArgs(args, *system.ithHart(i), system))
+      if (not args.interactive)
+	return false;
+
+  if (not args.serverFile.empty())
+    {
+      std::cerr << "This build has no server mode\n";
+      return false;
+    }
+
+  if (args.snapshotPeriod and *args.snapshotPeriod)
+    {
+      std::cerr << "This build has no snapshot mode\n";
+      return false;
+    }
+
+  if (args.interactive)
+    {
+      // In interactive mode: enable triggers and performance counters.
+      for (unsigned i = 0; i < system.hartCount(); ++i)
+        {
+          auto& hart = *system.ithHart(i);
+          hart.enableTriggers(true);
+          hart.enablePerformanceCounters(true);
+        }
+      s.shell.reset(new Interactive<URV>(system));
+    }
+  else
+    {
+      // Load error rollback is an annoyance if not in interactive mode.
+      for (unsigned i = 0; i < system.hartCount(); ++i)
+        {
+          auto& hart = *system.ithHart(i);
+          hart.enableLoadErrorRollback(false);
+          hart.enableBenchLoadExceptions(false);
+        }
+    }
 
+  s.args = &args;
+  s.traceFile = traceFile;
+  s.commandLog = cmdLog;
+  s.done = false;
+  s.ok = true;
   return true;
 }
 
 
+/// One slice. Run at most `budget` instructions, where zero means no limit,
+/// and return an AleStatus.
 template <typename URV>
 static
+int
+aleSlice(uint64_t budget)
+{
+  auto& s = aleSession<URV>();
+  if (s.done or not s.system)
+    return ALE_DONE;
+
+  Hart<URV>& hart = *s.system->ithHart(0);
+  hart.aleSetBudget(budget);
+
+  if (not s.shell)
+    {
+      // The batch run, which is what the run button of the application uses.
+      s.ok = hart.run(s.traceFile) and s.ok;
+      if (hart.aleWaiting())
+        return ALE_WAIT;
+      if (hart.aleYielded())
+        return ALE_RAN;
+      aleFinish<URV>();
+      return ALE_DONE;
+    }
+
+  // The interactive shell. `aleYielded` is false here unless this slice ran
+  // instructions, because a run that yields sets `running` and takes the
+  // branch above it.
+  if (s.running)
+    {
+      s.ok = hart.run(s.traceFile) and s.ok;
+      if (hart.aleWaiting())
+        return ALE_WAIT;
+      if (hart.aleYielded())
+        return ALE_RAN;
+      s.running = false;
+      s.shell->aleRunFinished(hart);
+      return ALE_WAIT;             // Back to the prompt.
+    }
