+/// Execute the commands that the host has sent, and then return.
+///
+/// `interact` above waits for a command in a loop around `emscripten_sleep`.
+/// Without Asyncify there is nothing to wait with, so this method takes the
+/// commands that are ready and returns. The slice driver of whisper.cpp calls
+/// it one time for each slice, and the messages of the host arrive between two
+/// slices.
+///
+/// A `run` or an `until` command does not finish inside this call. The hart
+/// stops when the budget of the slice runs out, and `Hart::aleYielded()` is
+/// then true. The driver continues that run in the slices that follow, and it
+/// asks for a new command only after the run is complete.
+template <typename URV>
+bool
+Interactive<URV>::interactSlice(FILE* traceFile, FILE* commandLog, bool& done)
+{
+  if (not aleStarted_)
+    {
+      linenoise::SetHistoryMaxLen(1024);
+      aleStarted_ = true;
+    }
+
+  char pstr[500];
+  errno = 0;
+  if (not readInteractiveCommand(pstr))
+    return true;            // No command is ready. Nothing to do this slice.
+
+  std::string line = pstr;
+  if (line.empty())
+    return true;
+
+  linenoise::AddHistory(line.c_str());
+
+  if (not executeLine(aleHartId_, line, traceFile, commandLog,
+                      aleReplayStream_, done))
+    aleErrors_++;
+
+  return aleErrors_ == 0;
+}
